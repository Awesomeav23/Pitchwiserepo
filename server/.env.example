# Local development. Copy to .env — .env is gitignored.
PORT=8787
DATABASE_URL=postgres://pitchwise:pitchwise@localhost:5433/pitchwise

# Managed auth provider (ADR-006). The choice between Clerk and Auth0 is still
# open (API_SPEC.md §14), so these are read from config rather than hardcoded —
# either provider works by filling them in.
AUTH_JWKS_URL=
AUTH_ISSUER=
AUTH_AUDIENCE=

# Development only. When true, the API accepts an unsigned header
#   Authorization: Bearer dev:<subject>:<email>:<name>
# so the client can be developed before a provider is chosen. Refuses to start
# with this enabled unless NODE_ENV is development.
AUTH_DEV_MODE=true

# DATA_MODEL §5.1. Server-side so it can be retuned without a client release.
COVERAGE_THRESHOLD=0.5

CLIENT_ORIGIN=http://localhost:5173
