# Local development. Copy to .env — .env is gitignored.
PORT=8787
DATABASE_URL=postgres://pitchwise:pitchwise@localhost:5433/pitchwise

# Managed auth provider — Clerk (ADR-006, ADR-016). Verification is generic, so
# these three values are the whole integration.
#
#   AUTH_JWKS_URL   https://<your-frontend-api>.clerk.accounts.dev/.well-known/jwks.json
#   AUTH_ISSUER     https://<your-frontend-api>.clerk.accounts.dev
#   AUTH_AUDIENCE   leave blank — Clerk session tokens set no audience by default
#
# Clerk's session token must also carry an email claim, which it does not by
# default. Add it under Configure → Sessions:
#   "email": "{{user.primary_email_address}}"
AUTH_JWKS_URL=
AUTH_ISSUER=
AUTH_AUDIENCE=

# Development only. When true, the API accepts an unsigned header
#   Authorization: Bearer dev:<subject>:<email>:<name>
# so the client can be developed before a provider is chosen. Refuses to start
# with this enabled unless NODE_ENV is development.
AUTH_DEV_MODE=true

# DATA_MODEL §5.1. Server-side so it can be retuned without a client release.
COVERAGE_THRESHOLD=0.5

CLIENT_ORIGIN=http://localhost:5173
