// The seed imports the client's content modules, which use extensionless
// specifiers because they are bundled rather than run by Node. It is itself
// bundled by esbuild before it runs, so it is checked under bundler resolution
// rather than losing type coverage or being excluded outright.
//
// Two configs is the cost of the package-boundary wart documented in seed.ts.
// A shared workspace removes both.
{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true
  },
  "include": ["src/db/seed.ts"]
}
