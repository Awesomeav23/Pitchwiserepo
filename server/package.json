{
  "name": "server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --watch --experimental-strip-types src/index.ts",
    "build": "tsc -b",
    "start": "node dist/index.js",
    "migrate": "node --experimental-strip-types src/db/migrate.ts",
    "seed": "esbuild src/db/seed.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/seed.mjs --log-level=warning && node dist/seed.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.seed.json",
    "verify": "node --experimental-strip-types src/verify-api.ts"
  },
  "dependencies": {
    "express": "^5.1.0",
    "jose": "^6.1.0",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.15.5",
    "esbuild": "^0.28.2",
    "typescript": "~6.0.2"
  }
}
