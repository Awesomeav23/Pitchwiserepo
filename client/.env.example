# Copy to .env.local — that file is gitignored.

# The API. Defaults to this if unset.
VITE_API_BASE=http://localhost:8787/api/v1

# Clerk (ADR-016). Leave blank to run on the development session instead, which
# needs no provider account — the app works either way.
#
#   1. Create an application at clerk.com
#   2. Copy the publishable key (pk_test_…) here
#   3. Under Configure → Sessions, add an email claim to the session token:
#        "email": "{{user.primary_email_address}}"
#   4. Put the matching JWKS URL and issuer in server/.env
VITE_CLERK_PUBLISHABLE_KEY=
